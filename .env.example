# Copy this file to .env and fill in the values from your Supabase project
# (Project Settings > Database > Connection string).

# Pooled connection (PgBouncer, transaction mode) — used by the app at runtime.
# Must include ?pgbouncer=true so Prisma disables prepared statements, which
# the transaction pooler does not support.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres?pgbouncer=true"

# Session-mode connection — used only by `prisma migrate`/`prisma db push`,
# which need a session-level advisory lock that the transaction pooler (6543)
# does not support.
#
# NOTE: Supabase's "Direct connection" host (db.<project-ref>.supabase.co) is
# IPv6-only on many projects and may be unreachable from networks/sandboxes
# without IPv6 egress (fails with P1001). If that happens, use the pooler
# host on port 5432 (session mode) instead, as shown below — same host as
# DATABASE_URL, just a different port and no ?pgbouncer=true.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres"

# Encrypts Session.accessToken/refreshToken at rest (AES-256-GCM, see
# app/utils/encryption.server.ts and app/encrypted-session-storage.server.ts)
# before they reach Supabase. Must be a base64-encoded 32-byte key. Generate
# one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME value in every environment that reads this database (local
# .env and each deployment's env vars, e.g. Vercel) - sessions encrypted with
# one key can't be decrypted with another, which would lock merchants out
# until they reinstall.
SESSION_ENCRYPTION_KEY="<base64-encoded-32-byte-key>"

# Error monitoring (see app/sentry.server.ts and app/entry.client.tsx). Both
# optional - omit either (or both) and that side simply doesn't report,
# with no crashes or warnings. Get a DSN from sentry.io > Settings >
# Projects > <project> > Client Keys (DSN).
#
# SENTRY_DSN: server-side errors (loader/action throws).
# VITE_SENTRY_DSN: client-side errors + session replay. Must use the VITE_
# prefix (baked into the client bundle at build time) - a plain SENTRY_DSN
# is server-only and never reaches the browser.
SENTRY_DSN="https://<key>@<org>.ingest.us.sentry.io/<project-id>"
VITE_SENTRY_DSN="https://<key>@<org>.ingest.us.sentry.io/<project-id>"
