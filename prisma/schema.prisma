// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum QuestionType {
  TEXT
  MULTIPLE_CHOICE
  SINGLE_CHOICE
  RATING
  YES_NO
}

model Shop {
  id         String   @id @default(cuid())
  shopDomain String   @unique
  email      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Cached Shopify App Pricing subscription state (see subscription.server.ts).
  // Shopify App Pricing has no webhook for subscription changes, so this is
  // refreshed lazily against the Partner API on a TTL rather than read live
  // on every request - the Partner API's rate limit is shared across every
  // merchant using this app, not per-shop like the Admin API.
  subscriptionActive           Boolean   @default(false)
  subscriptionPlanHandle       String?
  subscriptionTrialEndsAt      DateTime?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionCheckedAt        DateTime?

  // Cached usage against the plan's included-orders cap (see PLAN_TIERS in
  // billing.server.ts and getUsageStatus in subscription.server.ts). Orders
  // are counted for the current calendar month (UTC) - refreshed lazily on
  // a TTL, same reasoning as the subscription fields above: this is read on
  // checkout's hottest path (api.active-survey), so it can't run a live
  // COUNT query per request.
  usagePeriodStart      DateTime?
  usagePeriodOrderCount Int       @default(0)
  usageCheckedAt        DateTime?

  surveys             Survey[]
  orders              Order[]
  feedbackSubmissions Feedback[]
}

model Survey {
  id          String       @id @default(cuid())
  shopId      String
  shop        Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      SurveyStatus @default(DRAFT)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  questions Question[]
  responses Response[]

  @@index([shopId])
}

model Question {
  id        String       @id @default(cuid())
  surveyId  String
  survey    Survey       @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  label     String
  type      QuestionType
  options   Json?
  position  Int          @default(0)
  required  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  responses Response[]

  @@index([surveyId])
}

model Order {
  id             String    @id @default(cuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyOrderId String
  orderNumber    String?
  totalPrice     Decimal?
  currency       String?
  orderCreatedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  responses Response[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId])
}

model Response {
  id           String   @id @default(cuid())
  submissionId String
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  surveyId     String
  survey       Survey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answerText   String?
  answerValue  Json?
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([surveyId])
  @@index([questionId])
  @@index([submissionId])
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  OTHER
}

model Feedback {
  id           String       @id @default(cuid())
  shopId       String
  shop         Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type         FeedbackType
  message      String
  contactEmail String?
  createdAt    DateTime     @default(now())

  @@index([shopId])
}
